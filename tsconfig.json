{
    "include": [".astro/types.d.ts", "**/*", "src/services/fetchTypes.ts"],
    "exclude": ["dist"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "strictNullChecks": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "noEmit": true
    }
}
