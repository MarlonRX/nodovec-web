---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { colorConfig } from "../styles/colorConfig";
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Sidebar from "../components/Sidebar.astro";
import { Toaster } from "@/components/ui/sonner";
import { SidebarLayoutManager } from "../components/reactComponents/SidebarLayoutManager";
import { DebugValidator } from "../components/reactComponents/DebugValidator";
import { ThemeRestorer } from "../components/reactComponents/ThemeRestorer";

// Obtener token de las cookies (servidor-side)
const token = Astro.cookies.get("auth_token")?.value;
const isAuthenticated = !!token;

// Detectar si estamos en una página de login
const isLoginPage = Astro.url.pathname === "/login" || Astro.url.pathname === "/register";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={SITE_DESCRIPTION} />
        <title>{SITE_TITLE}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <script is:inline>
            const THEME_KEY = 'cash_pilot_theme';
            const VALID_THEMES = ['light', 'dark', 'custom', 'obsidian', 'midnight-teal', 'ember', 'violet-dusk', 'forest-night'];
            
            function restoreTheme() {
                try {
                    const t = localStorage.getItem(THEME_KEY);
                    if(t && VALID_THEMES.includes(t)) {
                        document.documentElement.setAttribute('data-theme', t);
                        console.log('[Inline] Theme SET:', t);
                    } else {
                        console.warn('[Inline] No valid theme, defaulting');
                        document.documentElement.setAttribute('data-theme', 'dark');
                    }
                }catch(e){
                    console.error('[Inline] Error:', e);
                }
            }
            
            // Restaurar INMEDIATAMENTE al cargar
            console.log('[Inline] Initial restore');
            restoreTheme();
            
            // Monitorear cambios cada 50ms (muy agresivo)
            let lastTheme = localStorage.getItem(THEME_KEY);
            setInterval(() => {
                const current = localStorage.getItem(THEME_KEY);
                if(current !== lastTheme) {
                    console.log('[Inline] Theme changed detected:', lastTheme, '->', current);
                    lastTheme = current;
                    restoreTheme();
                }
            }, 50);
            
            // Monitorear cambios de URL
            let lastUrl = location.href;
            setInterval(() => {
                if(location.href !== lastUrl) {
                    console.log('[Inline] URL changed:', lastUrl, '->', location.href);
                    lastUrl = location.href;
                    restoreTheme();
                }
            }, 100);
            
            // Escuchar cambios desde otras pestañas
            window.addEventListener('storage', (e) => {
                if(e.key === THEME_KEY) {
                    console.log('[Inline] Storage event:', e.newValue);
                    restoreTheme();
                }
            });
        </script>
    </head>
    <body
        class="h-screen overflow-hidden"
        style={`background: var(--bg-primary); color: var(--text-primary);`}
    >
        <Toaster client:load />
        <DebugValidator client:only="react" />
        <SidebarLayoutManager client:only="react" />
        <NavBar />
        <div class={`flex h-full overflow-hidden ${!isLoginPage ? 'pt-16' : ''}`}>
            <Sidebar isAuthenticated={isAuthenticated} />
            <main
                id="main-content"
                class="flex-1 w-full transition-all duration-300 flex flex-col overflow-y-auto"
                style={`background: var(--bg-surface); margin-left: ${isAuthenticated ? '5rem' : '0'};`}
            >
                <div class="flex flex-col w-full">
                    <slot />
                </div>
            </main>
        </div>
        <!-- Footer removed for single-screen layout -->

        <style>
            @media (max-width: 768px) {
                #main-content {
                    margin-left: 0 !important;
                }
            }
        </style>
    </body>
</html>
