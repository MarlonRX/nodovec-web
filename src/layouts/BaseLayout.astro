---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { colorConfig } from "../styles/colorConfig";
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Sidebar from "../components/Sidebar.astro";
import { Toaster } from "@/components/ui/sonner";
import { SidebarLayoutManager } from "../components/reactComponents/SidebarLayoutManager";
import { DebugValidator } from "../components/reactComponents/DebugValidator";

// Obtener token de las cookies (servidor-side)
const token = Astro.cookies.get("auth_token")?.value;
const isAuthenticated = !!token;

// Detectar si estamos en una página de login
const isLoginPage = Astro.url.pathname === "/login" || Astro.url.pathname === "/register";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={SITE_DESCRIPTION} />
        <title>{SITE_TITLE}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <script is:inline>
            (function(){
                try{
                    const t = localStorage.getItem('cash_pilot_theme');
                    if(t) document.documentElement.setAttribute('data-theme', t);
                    else if(window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.setAttribute('data-theme', 'light');
                    else document.documentElement.setAttribute('data-theme', 'dark');
                }catch(e){}
            })();
        </script>
    </head>
    <body
        class="h-screen overflow-hidden"
        style={`background: var(--bg-primary); color: var(--text-primary);`}
    >
        <Toaster client:load />
        <DebugValidator client:only="react" />
        <SidebarLayoutManager client:only="react" />
        <NavBar />
        <div class={`flex h-full overflow-hidden ${!isLoginPage ? 'pt-16' : ''}`}>
            <Sidebar isAuthenticated={isAuthenticated} />
            <main
                id="main-content"
                class="flex-1 w-full transition-all duration-300 flex flex-col overflow-hidden"
                style={`background: var(--bg-surface); margin-left: ${isAuthenticated ? '5rem' : '0'};`}
            >
                <div class="flex flex-col">
                    <slot />
                </div>
            </main>
        </div>
        <!-- Footer removed for single-screen layout -->

        <style>
            @media (max-width: 768px) {
                #main-content {
                    margin-left: 0 !important;
                }
            }
        </style>
    </body>
</html>
