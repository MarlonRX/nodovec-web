---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CardsPage, type CardsInitialData } from "@/components/reactComponents/cards/CardsPage";
import { getCards } from "@/services/cardServices";

export const prerender = false;

const token = Astro.cookies.get("auth_token")?.value ?? null;

let initialData: CardsInitialData | null = null;
if (token) {
  const result = await getCards({ page: 1 }, token);
  if (result.response && result.data) {
    initialData = {
      data: result.data.data ?? [],
      totalPages: result.data.last_page ?? 1,
    };
  }
}
---

<BaseLayout>
    <CardsPage client:load initialData={initialData} />
</BaseLayout>
