---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PasswordInput } from "../components/reactComponents/PasswordInput";
import { LoadingSpinner } from "../components/reactComponents/LoadingSpinner";
import { translate, getCurrentLanguage } from "../i18n";

export const prerender = false;

const lang = getCurrentLanguage();
const t = (key: string) => translate(key, lang);

// Si ya está autenticado, redirigir al dashboard
const token = Astro.cookies.get("auth_token");
if (token) {
  return Astro.redirect("/dashboard");
}
---

<BaseLayout>
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <!-- Logo / Header -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-black text-(--text-primary) mb-2 tracking-tight">NodoVec</h1>
        <p class="text-(--text-secondary) text-sm uppercase tracking-widest">{t("auth.signInToAccount")}</p>
      </div>

      <!-- Login Form -->
      <div class="bg-(--bg-surface) border border-(--border-primary) rounded-2xl p-8 shadow-xl">
        <form id="login-form" class="space-y-6">
          <!-- Email Input -->
          <div>
            <label for="email" class="block text-sm font-bold text-(--text-primary) mb-2 uppercase tracking-wide">
              {t("auth.email")}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-3 bg-(--bg-secondary) border-2 border-(--border-primary) rounded-lg text-(--text-primary) placeholder-(--text-tertiary) focus:outline-none focus:border-(--accent-primary) transition-colors"
            />
          </div>

          <!-- Password Input -->
          <div>
            <label for="password" class="block text-sm font-bold text-(--text-primary) mb-2 uppercase tracking-wide">
              {t("auth.password")}
            </label>
            <PasswordInput 
              id="password"
              name="password"
              placeholder="••••••••"
              required
              showRequirements={false}
              client:only="react"
            />
          </div>

          <!-- Error Message (Hidden by default) -->
          <div id="error-message" class="hidden px-4 py-3 bg-red-500/10 border border-red-500/30 rounded-lg">
            <p class="text-sm text-red-600 dark:text-red-400 font-medium"></p>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full px-6 py-3 bg-(--accent-primary) text-(--text-inverted) font-black text-sm uppercase tracking-wider rounded-xl hover:bg-(--accent-hover) transition-all shadow-lg hover:shadow-(--accent-primary)/30 hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="button-text">{t("auth.signIn")}</span>
            <span id="loading-spinner" class="hidden">
              <LoadingSpinner client:only="react" />
            </span>
          </button>
        </form>

        <!-- Divider -->
        <div class="flex items-center gap-4 my-6">
          <div class="flex-1 h-px bg-(--border-primary)"></div>
          <span class="text-xs text-(--text-tertiary) uppercase font-bold">{t("auth.or")}</span>
          <div class="flex-1 h-px bg-(--border-primary)"></div>
        </div>

        <!-- Demo Mode Link -->
        <a
          href="/demo"
          class="w-full block text-center px-6 py-3 bg-(--bg-secondary) text-(--text-primary) font-black text-sm uppercase tracking-wider rounded-xl border-2 border-(--border-primary) hover:border-(--accent-primary) transition-all"
        >
          {t("auth.tryDemoMode")}
        </a>
      </div>

      <!-- Sign Up Link -->
      <div class="text-center mt-6">
        <p class="text-(--text-secondary) text-sm">
          {t("auth.noAccount")}
          <a href="/register" class="text-(--accent-primary) font-bold hover:underline">
            {t("auth.signUpHere")}
          </a>
        </p>
      </div>

      <!-- Back to Home -->
      <div class="text-center mt-4">
        <a href="/" class="text-(--text-tertiary) text-xs hover:text-(--text-secondary) transition-colors">
          {t("auth.backHome")}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { toast } from "sonner";
  import { authStore } from "../store/auth";
  import { loginUser } from "@/services/userServices";
  import { translate, getCurrentLanguage } from "@/i18n";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-message") as HTMLDivElement;
  const errorText = errorMsg.querySelector("p") as HTMLParagraphElement;
  const btnText = document.getElementById("button-text") as HTMLSpanElement;
  const spinner = document.getElementById("loading-spinner") as HTMLSpanElement;
  const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement;

  const t = (key: string, vars?: Record<string, string | number>) => {
    let text = translate(key, getCurrentLanguage());
    if (vars) {
      for (const [k, v] of Object.entries(vars)) {
        text = text.replace(`{${k}}`, String(v));
      }
    }
    return text;
  };

  function showError(message: string) {
    errorText.textContent = message;
    errorMsg.classList.remove("hidden");
  }

  function hideError() {
    errorMsg.classList.add("hidden");
  }

  function refreshSubmitText() {
    btnText.textContent = t("auth.signIn");
  }

  refreshSubmitText();
  window.addEventListener("languageChanged", refreshSubmitText);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    const email = (form.querySelector("#email") as HTMLInputElement).value;
    const password = (form.querySelector("#password") as HTMLInputElement).value;

    // Validaciones básicas
    if (!email || !password) {
      showError(t("auth.fillAllFields"));
      return;
    }

    // Show loading state
    submitBtn.disabled = true;
    btnText.classList.add("hidden");
    spinner.classList.remove("hidden");

    try {
      const resp = await loginUser({ email, password });

      if (resp.response === true) {
        // Guardar en el store
        authStore.login(resp.data.token, resp.data.user);
        
        // Mostrar toast de éxito
        const userName = resp.data.user?.first_name || email;
        toast.success(t("auth.welcomeBack", { name: userName }));
        
        // Redirigir al dashboard
        setTimeout(() => {
          window.location.href = "/dashboard";
        }, 1500);
      } else {
        // Mostrar error
        const errorMessage = resp.message || t("auth.loginFailed");
        
        let displayError = errorMessage;
        if (errorMessage.toLowerCase().includes("invalid email or password")) {
          displayError = t("auth.invalidCredentials");
        }
        
        showError(displayError);
        toast.error(displayError);
      }
    } catch (error) {
      console.log("Network error during login:", error);
      const errorMessage = t("auth.networkError");
      showError(errorMessage);
      toast.error(errorMessage);
    } finally {
      submitBtn.disabled = false;
      btnText.classList.remove("hidden");
      spinner.classList.add("hidden");
    }
  });
</script>
