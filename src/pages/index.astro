---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FeatureIcon } from "../components/reactComponents/FeatureIcon";
import { translate, getCurrentLanguage } from "../i18n";

export const prerender = false;

const lang = getCurrentLanguage();
const t = (key: string) => translate(key, lang);

// Middleware ya maneja los redirects, así que no necesitamos lógica aquí
---

<BaseLayout>
  <div class="w-full flex flex-col items-center justify-center px-4 pt-20 pb-20">
    <!-- Hero Section -->
    <div class="max-w-2xl text-center">
      <div class="inline-block px-4 py-2 bg-(--accent-primary)/10 border border-(--accent-primary)/30 rounded-none mb-6">
        <span class="text-sm font-medium text-(--accent-primary) tracking-wide">{t("landing.welcomeTo")}</span>
      </div>

      <h1 class="text-6xl font-semibold text-(--text-primary) mb-4 tracking-tight">
        NodoVec
      </h1>

      <p class="text-xl text-(--text-secondary) mb-2 leading-relaxed">
        {t("landing.heroSubtitle")}
      </p>

      <p class="text-(--text-tertiary) mb-12">
        {t("landing.heroDescription")}
      </p>

      <!-- Features Grid -->
      <div class="grid grid-cols-3 gap-4 mb-12 py-8 border-y border-(--border-primary)">
        <div class="flex flex-col items-center gap-2">
          <div class="text-3xl text-(--accent-primary)">
            <FeatureIcon client:load icon="dashboard" size={32} />
          </div>
          <p class="text-sm font-medium text-(--text-secondary)">{t("landing.realTimeDashboard")}</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="text-3xl text-(--accent-primary)">
            <FeatureIcon client:load icon="transactions" size={32} />
          </div>
          <p class="text-sm font-medium text-(--text-secondary)">{t("landing.trackTransactions")}</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="text-3xl text-(--accent-primary)">
            <FeatureIcon client:load icon="analytics" size={32} />
          </div>
          <p class="text-sm font-medium text-(--text-secondary)">{t("landing.smartAnalytics")}</p>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <!-- Demo Button -->
        <a
          href="/demo"
          class="flex items-center justify-center gap-2 px-8 py-4 bg-(--accent-primary) text-(--text-inverted) font-semibold text-sm rounded-none hover:bg-(--accent-hover) transition-colors"
        >
          <span class="text-xl">
            <FeatureIcon client:load icon="demo" size={20} />
          </span>
          {t("landing.tryDemoFirst")}
        </a>

        <!-- Sign In Button -->
        <a
          href="/login"
          class="flex items-center justify-center gap-2 px-8 py-4 bg-(--bg-secondary) text-(--text-primary) border border-(--border-primary) font-semibold text-sm rounded-none hover:border-(--accent-primary) hover:text-(--accent-primary) transition-colors"
        >
          <span class="text-xl">
            <FeatureIcon client:load icon="security" size={20} />
          </span>
          {t("landing.signIn")}
        </a>
      </div>

      <!-- Sign Up Link -->
      <div class="mt-8">
        <p class="text-(--text-secondary) text-sm">
          {t("landing.newToNodoVec")}
          <a href="/register" class="text-(--accent-primary) font-semibold hover:underline">
            {t("landing.createAccount")}
          </a>
        </p>
      </div>
    </div>

    <!-- Features Section -->
    <div class="max-w-4xl w-full mt-20 pt-20 border-t border-(--border-primary)">
      <h2 class="text-3xl font-semibold text-(--text-primary) mb-12 tracking-tight">
        {t("landing.whyChoose")}
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-6 bg-(--bg-secondary) rounded-none border border-(--border-primary)">
          <div class="mb-3 text-(--accent-primary)">
            <FeatureIcon client:load icon="lightbulb" size={28} />
          </div>
          <h3 class="font-semibold text-(--text-primary) mb-2">{t("landing.smartCategorization")}</h3>
          <p class="text-(--text-secondary) text-sm leading-relaxed">
            {t("landing.smartCategorizationDesc")}
          </p>
        </div>

        <div class="p-6 bg-(--bg-secondary) rounded-none border border-(--border-primary)">
          <div class="mb-3 text-(--accent-primary)">
            <FeatureIcon client:load icon="target" size={28} />
          </div>
          <h3 class="font-semibold text-(--text-primary) mb-2">{t("landing.budgetControl")}</h3>
          <p class="text-(--text-secondary) text-sm leading-relaxed">
            {t("landing.budgetControlDesc")}
          </p>
        </div>

        <div class="p-6 bg-(--bg-secondary) rounded-none border border-(--border-primary)">
          <div class="mb-3 text-(--accent-primary)">
            <FeatureIcon client:load icon="mobile" size={28} />
          </div>
          <h3 class="font-semibold text-(--text-primary) mb-2">{t("landing.responsiveDesign")}</h3>
          <p class="text-(--text-secondary) text-sm leading-relaxed">
            {t("landing.responsiveDesignDesc")}
          </p>
        </div>

        <div class="p-6 bg-(--bg-secondary) rounded-none border border-(--border-primary)">
          <div class="mb-3 text-(--accent-primary)">
            <FeatureIcon client:load icon="secure" size={28} />
          </div>
          <h3 class="font-semibold text-(--text-primary) mb-2">{t("landing.securePrivate")}</h3>
          <p class="text-(--text-secondary) text-sm leading-relaxed">
            {t("landing.securePrivateDesc")}
          </p>
        </div>
      </div>
    </div>

    <!-- Demo Mode Info -->
    <div class="max-w-2xl w-full mt-20 p-8 bg-(--bg-secondary) rounded-none">
      <h3 class="font-semibold text-(--text-primary) mb-3 flex items-center gap-2">
        <span class="text-(--accent-primary)">
          <FeatureIcon client:load icon="demo" size={22}/>
        </span>
        {t("landing.tryDemoMode")}
      </h3>
      <p class="text-(--text-secondary) text-sm mb-4">
        {t("landing.demoInfoDesc")}
      </p>
      <p class="text-(--text-tertiary) text-xs">
        {t("landing.demoReadonlyNote")}
      </p>
    </div>

    <!-- Footer -->
    <div class="max-w-2xl w-full mt-20 pt-8 border-t border-(--border-primary) text-center">
      <p class="text-(--text-tertiary) text-xs mb-4">
        {t("landing.madeWith", { heart: t("landing.heart") })}
      </p>
      <div class="flex justify-center gap-4 text-sm">
        <a href="#" class="text-(--text-secondary) hover:text-(--accent-primary) transition-colors">{t("landing.privacy")}</a>
        <span class="text-(--border-primary)">•</span>
        <a href="#" class="text-(--text-secondary) hover:text-(--accent-primary) transition-colors">{t("landing.terms")}</a>
        <span class="text-(--border-primary)">•</span>
        <a href="#" class="text-(--text-secondary) hover:text-(--accent-primary) transition-colors">{t("landing.support")}</a>
      </div>
    </div>
  </div>
</BaseLayout>
