---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FeatureIcon } from "../components/reactComponents/FeatureIcon";

export const prerender = false;

// Middleware ya maneja los redirects, así que no necesitamos lógica aquí
---

<BaseLayout>
  <div class="w-full flex flex-col items-center justify-center px-4 pt-20 pb-20">
    <!-- Hero Section -->
    <div class="max-w-2xl text-center">
      <div class="inline-block px-4 py-2 bg-blue-500/10 border border-blue-500/30 rounded-full mb-6">
        <span class="text-sm font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Welcome to</span>
      </div>
      
      <h1 class="text-6xl font-black text-(--text-primary) mb-4 tracking-tight">
        CashPilot
      </h1>
      
      <p class="text-xl text-(--text-secondary) mb-2 leading-relaxed">
        Take control of your finances with powerful, intuitive transaction management
      </p>
      
      <p class="text-(--text-tertiary) mb-12">
        Track income, manage expenses, and visualize your financial health in real-time
      </p>

      <!-- Features Grid -->
      <div class="grid grid-cols-3 gap-4 mb-12 py-8 border-y border-(--border-primary)">
        <div class="flex flex-col items-center gap-2">
          <div class="text-3xl text-blue-500">
            <FeatureIcon client:load icon="dashboard" size={32} />
          </div>
          <p class="text-sm font-bold text-(--text-secondary) uppercase">Real-time Dashboard</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="text-3xl text-green-500">
            <FeatureIcon client:load icon="transactions" size={32} />
          </div>
          <p class="text-sm font-bold text-(--text-secondary) uppercase">Track Transactions</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="text-3xl text-purple-500">
            <FeatureIcon client:load icon="analytics" size={32} />
          </div>
          <p class="text-sm font-bold text-(--text-secondary) uppercase">Smart Analytics</p>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <!-- Demo Button -->
        <a
          href="/demo"
          class="group flex items-center justify-center gap-2 px-8 py-4 bg-yellow-500/20 border-2 border-yellow-500/40 text-yellow-600 dark:text-yellow-400 font-black text-sm uppercase tracking-wider rounded-xl hover:border-yellow-500/60 hover:bg-yellow-500/30 transition-all shadow-lg hover:-translate-y-0.5"
        >
          <span class="text-xl text-yellow-600 dark:text-yellow-400">
            <FeatureIcon client:load icon="demo" size={20} />
          </span>
          Try Demo First
          <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
        </a>

        <!-- Sign In Button -->
        <a
          href="/login"
          class="group flex items-center justify-center gap-2 px-8 py-4 bg-(--accent-primary) text-(--text-inverted) font-black text-sm uppercase tracking-wider rounded-xl hover:bg-(--accent-hover) transition-all shadow-lg hover:shadow-(--accent-primary)/30 hover:-translate-y-0.5 active:translate-y-0"
        >
          <span class="text-xl">
            <FeatureIcon client:load icon="security" size={20} />
          </span>
          Sign In
          <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
        </a>
      </div>

      <!-- Sign Up Link -->
      <div class="mt-8">
        <p class="text-(--text-secondary) text-sm">
          New to CashPilot?
          <a href="/register" class="text-(--accent-primary) font-bold hover:underline">
            Create an account
          </a>
        </p>
      </div>
    </div>

    <!-- Features Section -->
    <div class="max-w-4xl w-full mt-20 pt-20 border-t border-(--border-primary)">
      <h2 class="text-3xl font-black text-(--text-primary) text-center mb-12 uppercase tracking-tight">
        Why Choose CashPilot?
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="p-6 bg-(--bg-secondary) rounded-xl border border-(--border-primary)">
          <div class="text-4xl mb-3 text-amber-500">
            <FeatureIcon client:load icon="lightbulb" size={40} />
          </div>
          <h3 class="font-black text-(--text-primary) mb-2 uppercase">Smart Categorization</h3>
          <p class="text-(--text-secondary) text-sm">
            Automatically categorize transactions with color-coded badges for quick visual reference
          </p>
        </div>

        <div class="p-6 bg-(--bg-secondary) rounded-xl border border-(--border-primary)">
          <div class="text-4xl mb-3 text-red-500">
            <FeatureIcon client:load icon="target" size={40} />
          </div>
          <h3 class="font-black text-(--text-primary) mb-2 uppercase">Budget Control</h3>
          <p class="text-(--text-secondary) text-sm">
            Set budgets by category and receive alerts when you're approaching your limits
          </p>
        </div>

        <div class="p-6 bg-(--bg-secondary) rounded-xl border border-(--border-primary)">
          <div class="text-4xl mb-3 text-cyan-500">
            <FeatureIcon client:load icon="mobile" size={40} />
          </div>
          <h3 class="font-black text-(--text-primary) mb-2 uppercase">Responsive Design</h3>
          <p class="text-(--text-secondary) text-sm">
            Access your finances from any device - desktop, tablet, or mobile
          </p>
        </div>

        <div class="p-6 bg-(--bg-secondary) rounded-xl border border-(--border-primary)">
          <div class="text-4xl mb-3 text-emerald-500">
            <FeatureIcon client:load icon="secure" size={40} />
          </div>
          <h3 class="font-black text-(--text-primary) mb-2 uppercase">Secure & Private</h3>
          <p class="text-(--text-secondary) text-sm">
            Your financial data is encrypted and protected with enterprise-grade security
          </p>
        </div>
      </div>
    </div>

    <!-- Demo Mode Info -->
    <div class="max-w-2xl w-full mt-20 p-8 bg-blue-500/5 border-2 border-blue-500/20 rounded-2xl">
      <h3 class="font-black text-(--text-primary) mb-3 uppercase tracking-tight flex items-center gap-2">
        <FeatureIcon client:load icon="demo" size={24}/>
        Try Demo Mode
      </h3>
      <p class="text-(--text-secondary) text-sm mb-4">
        Want to explore CashPilot without signing up? Click "Try Demo First" above to see all features in action with sample data. No registration required!
      </p>
      <p class="text-(--text-tertiary) text-xs">
        Demo mode is read-only. Create an account to start managing your real transactions.
      </p>
    </div>

    <!-- Footer -->
    <div class="max-w-2xl w-full mt-20 pt-8 border-t border-(--border-primary) text-center">
      <p class="text-(--text-tertiary) text-xs uppercase tracking-widest mb-4">
        Made with ❤️ for financial freedom
      </p>
      <div class="flex justify-center gap-4 text-sm">
        <a href="#" class="text-(--text-secondary) hover:text-(--accent-primary) transition-colors">Privacy</a>
        <span class="text-(--border-primary)">•</span>
        <a href="#" class="text-(--text-secondary) hover:text-(--accent-primary) transition-colors">Terms</a>
        <span class="text-(--border-primary)">•</span>
        <a href="#" class="text-(--text-secondary) hover:text-(--accent-primary) transition-colors">Support</a>
      </div>
    </div>
  </div>
</BaseLayout>
