# Shared production defaults - safe to commit
# PUBLIC_API_BASE_URL and PUBLIC_API_URL are injected by Railway at build time
# (Vite picks them from process.env when not found in .env files)
PUBLIC_API_TIMEOUT=30000
PUBLIC_API_ACCEPT=application/json
PUBLIC_API_CONTENT_TYPE=application/json
PUBLIC_APP_NAME=NodoVec
PUBLIC_APP_VERSION=1.0.0
PUBLIC_DEV_MODE=false
PUBLIC_STORAGE_PREFIX=nodovec_
PUBLIC_TOKEN_STORAGE_KEY=auth_token
PUBLIC_USER_STORAGE_KEY=user_data
